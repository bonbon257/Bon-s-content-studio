# 本地开发使用：npm run dev 时浏览器会直接调用模型 API
VITE_LLM_API_KEY=your_local_api_key_here
VITE_LLM_BASE_URL=https://api.deepseek.com
VITE_LLM_MODEL=deepseek-chat

# 可选：本地聊天记录生成单独走另一个模型
VITE_CHAT_LLM_API_KEY=
VITE_CHAT_LLM_BASE_URL=
VITE_CHAT_LLM_MODEL=

# Vercel 云端使用：在 Vercel Project Settings -> Environment Variables 中配置
# 注意：这些不要写成 VITE_，否则会暴露到前端
LLM_API_KEY=your_cloud_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 可选：云端聊天记录生成单独走另一个模型
CHAT_LLM_API_KEY=
CHAT_LLM_BASE_URL=
CHAT_LLM_MODEL=

# 可选但建议配置：云端访问密码
APP_PASSWORD=change_this_password

# ===================== 云端同步（Vercel KV / Upstash Redis）=====================
# 用于跨设备同步风格 SKILL、通用方法论、用户偏好、爆文素材库。
# 配置方法：在 Vercel 项目页面 -> Storage -> 创建 KV 或 Upstash Redis，
# 创建后 Vercel 会自动注入以下环境变量之一（代码两种都兼容，无需手动填写）：
#   KV_REST_API_URL / KV_REST_API_TOKEN
#   或 UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# 未配置时，云端同步功能自动禁用，数据仍保存在各设备浏览器本地。
